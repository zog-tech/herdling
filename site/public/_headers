# Cloudflare Pages headers. Later rules add to earlier rules for the same header.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Pages that must always show the newest content.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/download
  Cache-Control: no-cache
/docs
  Cache-Control: no-cache
/support
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache

# Markdown twins and llms.txt, for people and AI assistants.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# Images and fonts change rarely; a new file gets a new name.
/img/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
