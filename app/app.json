{
  "expo": {
    "name": "Zogssh",
    "slug": "zogssh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zogssh",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zogtech.zogssh",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Zogssh connects to your computers on the local network over SSH and finds the ones that run zogsshd.",
        "NSBonjourServices": [
          "_zogssh._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Zogssh uses the microphone while you hold the mic button, to turn your speech into a prompt for the agent.",
        "NSSpeechRecognitionUsageDescription": "Zogssh turns what you say into a prompt for the agent. Recognition runs on the device when your language supports it.",
        "NSPhotoLibraryUsageDescription": "Zogssh attaches photos you pick to prompts for your agents."
      },
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zogtech.zogssh"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Zogssh uses the camera to scan the pairing QR code that zogsshd pair shows."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zogssh attaches photos you pick to prompts for your agents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bfac8d0c-87ff-42be-877a-8907b4fe587c"
      }
    },
    "owner": "admin.zogtech",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bfac8d0c-87ff-42be-877a-8907b4fe587c",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
