{
  "expo": {
    "name": "Herdling",
    "slug": "zogssh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "herdling",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.zogtech.herdling",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Herdling connects to your computers on the local network over SSH and finds the ones that run herdlingd.",
        "NSBonjourServices": [
          "_herdling._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Herdling uses the microphone while you record with the mic button, to turn your speech into a prompt for the agent.",
        "NSSpeechRecognitionUsageDescription": "Herdling turns what you say into a prompt for the agent. Recognition runs on the device when your language supports it.",
        "NSPhotoLibraryUsageDescription": "Herdling attaches photos you pick to prompts for your agents."
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zogtech.herdling",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Herdling uses the camera to scan the pairing QR code that herdlingd pair shows."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "exclude": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Herdling attaches photos you pick to prompts for your agents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bfac8d0c-87ff-42be-877a-8907b4fe587c"
      }
    },
    "owner": "admin.zogtech",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bfac8d0c-87ff-42be-877a-8907b4fe587c",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
